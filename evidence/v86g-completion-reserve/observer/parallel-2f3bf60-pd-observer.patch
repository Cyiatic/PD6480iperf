+/* Diagnostic observation only; no guest writes or emulated-cycle updates. */
+#ifndef PD_OBSERVER_H
+#define PD_OBSERVER_H
+#include <stdint.h>
+struct r4300_core;
+void pd_observe(const char *event, uint32_t a, uint32_t b);
+void pd_observe_guest(struct r4300_core *cpu, uint32_t pc);
+#endif
